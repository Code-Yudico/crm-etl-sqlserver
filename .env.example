# Copy this file to .env and adjust the values. Never commit .env.

# --- SQL Server connection -------------------------------------------------
# Matches the service defined in docker-compose.yml.
SQL_SERVER=localhost,1433
SQL_DATABASE=crm_etl_demo
SQL_USER=sa
SQL_PASSWORD=Local_Dev_Pass123

# ODBC Driver 18 is the current Microsoft driver. Driver 17 also works.
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Driver 18 negotiates an encrypted connection by default, and the local
# container presents a self-signed certificate. Trusting it is acceptable for
# local development only: leave this as "no" against a real server.
SQL_TRUST_SERVER_CERTIFICATE=yes

# --- Pipeline --------------------------------------------------------------
# Folder the simulated CRM export is read from.
INPUT_DIR=data/incoming

# Rows that fail validation are written here for inspection.
REJECTS_DIR=rejects

# Rows per INSERT batch.
BATCH_SIZE=500
